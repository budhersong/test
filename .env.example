# 네이버 개발자 센터 (https://developers.naver.com) 에서 발급
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# Google Sheets 서비스 계정 JSON 파일 경로
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json

# 데이터를 저장할 Google Spreadsheet ID (URL에서 /d/ 다음 부분)
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id

# 앱 설정
APP_SECRET_KEY=change-this-to-a-random-secret
APP_PORT=8000

# 크롤링 주기 (기본: 매주 월요일 오전 9시)
SCHEDULE_DAY_OF_WEEK=mon
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0
